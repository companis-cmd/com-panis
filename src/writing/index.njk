---
layout: layouts/base.njk
bodyClass: parchment
title: Writing
description: Poems and pieces from Com Panis.
permalink: /writing/
---
<article class="reading">
  <h1>Writing</h1>
  {% for kind in ["Poetry", "Synthia"] %}
  {% set items = collections.writing | ofKind(kind) %}
  {% if items.length %}
  <h2 class="group">{{ kind }}</h2>
  <ul class="list">
    {% for post in items %}<li><a href="{{ post.url }}">{{ post.data.title }}</a></li>{% endfor %}
  </ul>
  {% endif %}
  {% endfor %}
</article>
